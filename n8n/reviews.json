{
  "name": "Reseñas UGC (captura + correos)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "reviews",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "rv-webhook",
      "name": "Webhook reseñas",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "reviews",
      "notes": "La Production URL de este nodo va en Vercel como N8N_REVIEWS_URL."
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "reviews",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "first_name",
              "fieldValue": "={{ $json.body.firstName }}"
            },
            {
              "fieldId": "last_name",
              "fieldValue": "={{ $json.body.lastName }}"
            },
            {
              "fieldId": "email",
              "fieldValue": "={{ $json.body.email }}"
            },
            {
              "fieldId": "phone",
              "fieldValue": "={{ $json.body.phone }}"
            },
            {
              "fieldId": "rating",
              "fieldValue": "={{ $json.body.rating }}"
            },
            {
              "fieldId": "body",
              "fieldValue": "={{ $json.body.body }}"
            },
            {
              "fieldId": "car_slug",
              "fieldValue": "={{ $json.body.carSlug }}"
            },
            {
              "fieldId": "car_sanity_id",
              "fieldValue": "={{ $json.body.carSanityId }}"
            },
            {
              "fieldId": "car_brand",
              "fieldValue": "={{ $json.body.carBrand }}"
            },
            {
              "fieldId": "car_model",
              "fieldValue": "={{ $json.body.carModel }}"
            },
            {
              "fieldId": "car_year",
              "fieldValue": "={{ $json.body.carYear }}"
            },
            {
              "fieldId": "car_color",
              "fieldValue": "={{ $json.body.carColor }}"
            },
            {
              "fieldId": "car_version",
              "fieldValue": "={{ $json.body.carVersion }}"
            },
            {
              "fieldId": "photos",
              "fieldValue": "={{ $json.body.photos }}"
            },
            {
              "fieldId": "source",
              "fieldValue": "={{ $json.body.source }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "pendiente"
            }
          ]
        },
        "options": {}
      },
      "id": "rv-supabase",
      "name": "Guardar reseña (pendiente)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        260,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REEMPLAZAR",
          "name": "Supabase (service_role)"
        }
      },
      "notes": "status='pendiente' SIEMPRE: nada se publica sin que Francisco lo apruebe en el dashboard."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "Electrificarte <no-reply@electrificarte.com>"
            },
            {
              "name": "to",
              "value": "francisco@electrificarte.com"
            },
            {
              "name": "subject",
              "value": "Nueva reseña por moderar"
            },
            {
              "name": "html",
              "value": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"light\">\n  <title>Nueva reseña por moderar</title>\n</head>\n<!--\n  RESEÑAS · USO INTERNO (Francisco). Se dispara cuando alguien envía una reseña.\n  ⚠️ La reseña NO se publica sola: nace con status='pendiente' y solo aparece en el\n  sitio cuando Francisco la aprueba desde el dashboard.\n  Expresiones n8n:\n    {{ $('Webhook reseñas').item.json.body.firstName }} {{ $('Webhook reseñas').item.json.body.lastName }}\n    {{ $('Webhook reseñas').item.json.body.rating }}  → 1 a 5\n    {{ $('Webhook reseñas').item.json.body.body }}    → texto de la reseña\n    {{ $('Webhook reseñas').item.json.body.carBrand }} {{ $('Webhook reseñas').item.json.body.carModel }} {{ $('Webhook reseñas').item.json.body.carYear }}\n    {{ $('Webhook reseñas').item.json.body.email }} {{ $('Webhook reseñas').item.json.body.phone }}\n-->\n<body style=\"margin:0;padding:0;background:#F3F4F6;font-family:'Helvetica Neue',Arial,sans-serif;-webkit-font-smoothing:antialiased;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">Hay una reseña esperando tu revisión.</div>\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F3F4F6;\">\n    <tr><td align=\"center\" style=\"padding:24px 12px;\">\n      <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:600px;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:16px;overflow:hidden;\">\n\n        <tr><td style=\"padding:26px 32px;border-bottom:1px solid #F3F4F6;\">\n          <table role=\"presentation\" width=\"100%\"><tr>\n            <td><picture><source srcset=\"https://www.electrificarte.com/logo-email-white.png\" media=\"(prefers-color-scheme: dark)\"><img src=\"https://www.electrificarte.com/logo-email.png\" alt=\"Electrificarte\" height=\"28\" style=\"display:block;border:0;height:28px;width:auto;\"></picture></td>\n            <td align=\"right\" style=\"font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:#9CA3AF;\">Uso interno</td>\n          </tr></table>\n        </td></tr>\n\n        <tr><td style=\"padding:36px 32px 8px;\">\n          <p style=\"margin:0 0 8px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#00A6A6;\">Pendiente de moderación</p>\n          <h1 style=\"margin:0 0 16px;font-size:24px;font-weight:800;line-height:1.2;color:#111827;letter-spacing:-0.01em;\">Nueva reseña por revisar</h1>\n          <p style=\"margin:0 0 20px;font-size:15px;line-height:1.65;color:#4B5563;\">Hola <strong style=\"color:#111827;\">Francisco</strong>, llegó una reseña nueva. <strong style=\"color:#111827;\">No está publicada</strong> — aparecerá en el sitio solo cuando la apruebes desde el dashboard.</p>\n\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border:1px solid #E5E7EB;border-radius:12px;margin:0 0 20px;\">\n            <tr><td style=\"padding:16px 20px;border-bottom:1px solid #F3F4F6;\">\n              <div style=\"font-size:11px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;color:#9CA3AF;\">Calificación</div>\n              <div style=\"font-size:22px;font-weight:700;color:#F59E0B;margin-top:3px;letter-spacing:2px;\">{{ '★'.repeat($('Webhook reseñas').item.json.body.rating) }}<span style=\"color:#D1D5DB;\">{{ '★'.repeat(5 - $('Webhook reseñas').item.json.body.rating) }}</span> <span style=\"font-size:14px;color:#4B5563;letter-spacing:0;\">{{ $('Webhook reseñas').item.json.body.rating }}/5</span></div>\n            </td></tr>\n            <tr><td style=\"padding:14px 20px;border-bottom:1px solid #F3F4F6;\">\n              <div style=\"font-size:11px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;color:#9CA3AF;\">Auto</div>\n              <div style=\"font-size:15px;font-weight:700;color:#006A61;margin-top:3px;\">{{ $('Webhook reseñas').item.json.body.carBrand }} {{ $('Webhook reseñas').item.json.body.carModel }} {{ $('Webhook reseñas').item.json.body.carYear || '' }}</div>\n            </td></tr>\n            <tr><td style=\"padding:16px 20px;border-bottom:1px solid #F3F4F6;\">\n              <div style=\"font-size:11px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;color:#9CA3AF;\">Reseña</div>\n              <div style=\"font-size:14px;line-height:1.65;color:#111827;margin-top:6px;\">{{ $('Webhook reseñas').item.json.body.body }}</div>\n            </td></tr>\n            <tr><td style=\"padding:14px 20px;\">\n              <div style=\"font-size:11px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;color:#9CA3AF;\">Quién la dejó</div>\n              <div style=\"font-size:15px;font-weight:700;color:#111827;margin-top:3px;\">{{ $('Webhook reseñas').item.json.body.firstName }} {{ $('Webhook reseñas').item.json.body.lastName }}</div>\n              <div style=\"font-size:13px;color:#4B5563;margin-top:2px;\">{{ $('Webhook reseñas').item.json.body.email }}</div>\n            </td></tr>\n          </table>\n\n          <p style=\"margin:0 0 24px;font-size:13px;line-height:1.6;color:#4B5563;\">Revisá que el contenido sea sobre el auto y apropiado antes de publicarla.</p>\n        </td></tr>\n\n        <tr><td style=\"padding:0 32px 36px;\">\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n            <td style=\"border-radius:12px;background:#00E5E5;\">\n              <a href=\"https://www.electrificarte.com\" style=\"display:inline-block;padding:15px 34px;font-size:14px;font-weight:700;color:#000000;text-decoration:none;border-radius:12px;\">Moderar en el dashboard</a>\n            </td>\n          </tr></table>\n        </td></tr>\n\n        <tr><td style=\"padding:28px 32px;background:#000000;\">\n          <p style=\"margin:0 0 6px;font-size:13px;font-weight:700;color:#FFFFFF;letter-spacing:-0.01em;\">ELECTRIFICARTE<span style=\"color:#00E5E5;\">.COM</span></p>\n          <p style=\"margin:0;font-size:12px;line-height:1.6;color:rgba(255,255,255,0.55);\">Alerta interna generada automáticamente.</p>\n        </td></tr>\n\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n"
            }
          ]
        },
        "options": {}
      },
