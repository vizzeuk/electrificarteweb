            {
              "name": "html",
              "value": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"light dark\">\n  <meta name=\"supported-color-schemes\" content=\"light dark\">\n  <title>Electrificarte</title>\n</head>\n<!--\n  WAITLIST DE VENDEDORES: aviso interno a Francisco.\n  Lee del nodo \"Webhook waitlist vendedores\": body.firstName, lastName, email, phone,\n  puntoVenta, marcas, region, comuna, mensaje, source.\n\n  GENERADO por scripts/gen-emails.mjs (sistema de diseño v1). No editar a mano: cambiá el\n  generador y corré  node scripts/gen-emails.mjs && node scripts/gen-waitlist-reviews-workflows.mjs\n  Todo dato que escribe el usuario va escapado para HTML.\n-->\n<body style=\"margin:0;padding:0;background:#f2f7f6;-webkit-font-smoothing:antialiased;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">Un vendedor dejó sus datos para la red.</div>\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f2f7f6;\">\n    <tr><td align=\"center\" style=\"padding:32px 12px;\">\n      <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:600px;\">\n\n        <tr><td style=\"padding:0 4px 20px;\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n            <td><picture><source srcset=\"https://www.electrificarte.com/brand/email-wordmark-niebla.png\" media=\"(prefers-color-scheme: dark)\"><img src=\"https://www.electrificarte.com/brand/email-wordmark-tinta.png\" alt=\"Electrificarte\" width=\"218\" height=\"16\" style=\"display:block;border:0;width:218px;height:16px;\"></picture></td>\n          </tr></table>\n        </td></tr>\n\n        <tr><td style=\"background:#ffffff;border:1px solid #dfe4e4;border-radius:12px;padding:36px 32px 32px;\">\n<h1 style=\"margin:0 0 16px;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:28px;font-weight:700;line-height:1.1;letter-spacing:-0.02em;color:#0f1716;\">Un vendedor quiere sumarse a la red</h1>\n<p style=\"margin:0 0 16px;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#495251;\">Dejó sus datos en la página de vendedores. Queda en la waitlist de vendedores del dashboard.</p>\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:8px 0 24px;border-top:1px solid #dfe4e4;\">\n  <tr>\n    <td style=\"padding:12px 16px 12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.4;color:#495251;vertical-align:top;width:34%;\">Vendedor</td>\n    <td style=\"padding:12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;font-weight:600;color:#0f1716;vertical-align:top;\">{{ String(($('Webhook waitlist vendedores').item.json.body.firstName) ?? '').trim().replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') }} {{ String(($('Webhook waitlist vendedores').item.json.body.lastName) ?? '').trim().replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px 12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.4;color:#495251;vertical-align:top;width:34%;\">Punto de venta</td>\n    <td style=\"padding:12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;font-weight:600;color:#0f1716;vertical-align:top;\">{{ String(($('Webhook waitlist vendedores').item.json.body.puntoVenta) ?? '').trim().replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') || 'Sin indicar' }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px 12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.4;color:#495251;vertical-align:top;width:34%;\">Marcas</td>\n    <td style=\"padding:12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;font-weight:600;color:#0f1716;vertical-align:top;\">{{ String(($('Webhook waitlist vendedores').item.json.body.marcas) ?? '').trim().replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') || 'Sin indicar' }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px 12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.4;color:#495251;vertical-align:top;width:34%;\">Ubicación</td>\n    <td style=\"padding:12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;font-weight:600;color:#0f1716;vertical-align:top;\">{{ [$('Webhook waitlist vendedores').item.json.body.comuna, $('Webhook waitlist vendedores').item.json.body.region].filter(Boolean).join(', ').replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') || 'Sin indicar' }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px 12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.4;color:#495251;vertical-align:top;width:34%;\">Teléfono</td>\n    <td style=\"padding:12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;font-weight:600;color:#0f1716;vertical-align:top;\">{{ String(($('Webhook waitlist vendedores').item.json.body.phone) ?? '').trim().replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px 12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.4;color:#495251;vertical-align:top;width:34%;\">Email</td>\n    <td style=\"padding:12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;font-weight:600;color:#0f1716;vertical-align:top;\">{{ String(($('Webhook waitlist vendedores').item.json.body.email) ?? '').trim().replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px 12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.4;color:#495251;vertical-align:top;width:34%;\">Mensaje</td>\n    <td style=\"padding:12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;font-weight:600;color:#0f1716;vertical-align:top;\">{{ String(($('Webhook waitlist vendedores').item.json.body.mensaje) ?? '').trim().replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') || 'Sin mensaje' }}</td>\n  </tr>\n</table>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:8px 0 0;\"><tr>\n  <td style=\"border-radius:8px;background:#1d605b;\">\n    <a href=\"https://wa.me/{{ String(($('Webhook waitlist vendedores').item.json.body.phone) ?? '').replace(/[^0-9]/g, '') }}\" style=\"display:inline-block;padding:14px 24px;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;line-height:1.2;color:#ffffff;text-decoration:none;border-radius:8px;\">Escribir por WhatsApp</a>\n  </td>\n</tr></table>\n        </td></tr>\n\n\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n"
            }
          ]
        },
