      "notes": "Lee la fuente (1 llamada a Claude), hace el diff aritmético y escribe los campos de auditoría. 10–20 s.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// El endpoint devuelve 502 cuando falla NUESTRA API (rate limit, 5xx), no cuando\n// falla la fuente. Con onError=continueRegularOutput eso llega acá como un item\n// con `error`, y hay que darle la misma forma que un resultado normal para que el\n// log y el digest no tengan que distinguir dos formatos.\nconst j = $input.first().json ?? {};\nif (j.resultado) return [{ json: j }];\nreturn [{ json: {\n  carId: j.carId ?? null,\n  nombre: j.nombre ?? 'desconocido',\n  resultado: 'error',\n  hallazgos: [],\n  error: j.error ?? j.message ?? 'fallo sin detalle',\n} }];"
      },
      "id": "norm",
      "name": "Normalizar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        560
      ],
      "notes": "Sin esto, un 502 rompe el JSON del cierre de corrida."
    },
    {
      "parameters": {
        "jsCode": "// Todos los autos ya revisados llegan juntos por la salida 'done' del loop.\nconst items = $input.all().map((i) => i.json);\nconst urgentes = items.filter((r) => r.urgente);\nreturn [{ json: {\n  runId: $('Tomar el lote').first().json.runId,\n  resultados: items,\n  urgentesTotal: urgentes.length,\n  urgentesTexto: urgentes\n    .map((r) => '• ' + r.nombre + ' — ' + (r.nota ?? r.flag))\n    .join('\\n'),\n} }];"
      },
      "id": "armar",
      "name": "Armar el cierre",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        380
      ],
      "notes": "urgente = descontinuado (ya ocultó algo del sitio) o fuente muerta (la revisión de ese auto está detenida). Todo lo demás espera al digest del lunes."
    },
