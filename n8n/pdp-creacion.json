    {
      "parameters": {
        "jsCode": "// `$runIndex` es cuántas veces corrió ESTE nodo en ESTA ejecución: 0 en la\n// primera vuelta, 1 en la segunda… Es el contador correcto para un ciclo.\n// El flujo anterior usaba $getWorkflowStaticData('global'), que es global al\n// workflow y se pisa entre ejecuciones concurrentes — por eso su propia nota\n// pedía 'worker concurrency 1'.\nconst max = Number($('Config').first().json.maxConsultas ?? 20);\nconst r = $input.first().json;\nconst corriendo = r.estado === 'corriendo';\nconst agotado = corriendo && $runIndex + 1 >= max;\nreturn [{ json: { ...r, corriendo: corriendo && !agotado, agotado, vuelta: $runIndex + 1, max } }];"
      },
      "id": "contar",
      "name": "¿Seguir esperando?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "notes": "Techo de vueltas para que una sesión colgada no deje la ejecución girando para siempre."
    },
