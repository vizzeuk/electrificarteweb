        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Web Electrificarte (x-electrificarte-secret)"
        }
      },
      "notes": "La Production URL de este nodo va en Vercel como N8N_WAITLIST_URL."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.firstName }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.body.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c3",
              "leftValue": "={{ $json.body.phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "wl-valid",
      "name": "¿Datos válidos? (waitlist)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        220,
        300
      ],
      "notes": "Si falta un dato obligatorio responde 422 y no guarda nada (la web ya valida lo mismo con zod)."
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "waitlist",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "first_name",
              "fieldValue": "={{ $json.body.firstName }}"
            },
            {
              "fieldId": "last_name",
              "fieldValue": "={{ $json.body.lastName }}"
