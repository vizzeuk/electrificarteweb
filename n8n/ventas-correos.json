              "value": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"light\">\n  <title>Nuevo vendedor — Electrificarte</title>\n</head>\n<!--\n  VENTAS · USO INTERNO (Francisco). Se dispara cuando un vendedor paga su\n  suscripción. Va DIRECTO al nodo Resend de n8n.\n  Expresiones n8n:\n    {{ $('Create a row1').item.json.nombre }} {{ $('Create a row1').item.json.apellido }}\n    {{ $('Create a row1').item.json.nombre_concesionario }}  → punto de venta\n    {{ $('Create a row1').item.json.telefono }}              → contacto\n    {{ $('Create a row1').item.json.marcas }}                → marcas\n-->\n<body style=\"margin:0;padding:0;background:#F3F4F6;font-family:'Helvetica Neue',Arial,sans-serif;-webkit-font-smoothing:antialiased;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">Nuevo vendedor pagó su suscripción — contactar para activar.</div>\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F3F4F6;\">\n    <tr><td align=\"center\" style=\"padding:24px 12px;\">\n      <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:600px;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:16px;overflow:hidden;\">\n\n        <tr><td style=\"padding:26px 32px;border-bottom:1px solid #F3F4F6;\">\n          <table role=\"presentation\" width=\"100%\"><tr>\n            <td><img src=\"https://www.electrificarte.com/logo-email.png\" alt=\"Electrificarte\" height=\"28\" style=\"display:block;border:0;height:28px;width:auto;\"></td>\n            <td align=\"right\" style=\"font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:#9CA3AF;\">Uso interno</td>\n          </tr></table>\n        </td></tr>\n\n        <tr><td style=\"padding:36px 32px 8px;\">\n          <p style=\"margin:0 0 8px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#00A6A6;\">Nuevo vendedor · suscripción pagada</p>\n          <h1 style=\"margin:0 0 16px;font-size:24px;font-weight:800;line-height:1.2;color:#111827;letter-spacing:-0.01em;\">Registro de vendedor completado</h1>\n          <p style=\"margin:0 0 20px;font-size:15px;line-height:1.65;color:#4B5563;\">Hola <strong style=\"color:#111827;\">Francisco</strong>, un nuevo vendedor completó su suscripción. Contactalo para verificar sus datos y activar su cuenta.</p>\n\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border:1px solid #E5E7EB;border-radius:12px;margin:0 0 20px;\">\n            <tr><td style=\"padding:14px 20px;border-bottom:1px solid #F3F4F6;\">\n              <div style=\"font-size:11px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;color:#9CA3AF;\">Vendedor</div>\n              <div style=\"font-size:15px;font-weight:700;color:#111827;margin-top:3px;\">{{ $('Create a row1').item.json.nombre }} {{ $('Create a row1').item.json.apellido }}</div>\n            </td></tr>\n            <tr><td style=\"padding:14px 20px;border-bottom:1px solid #F3F4F6;\">\n              <div style=\"font-size:11px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;color:#9CA3AF;\">Punto de venta</div>\n              <div style=\"font-size:15px;font-weight:700;color:#111827;margin-top:3px;\">{{ $('Create a row1').item.json.nombre_concesionario }}</div>\n            </td></tr>\n            <tr>\n              <td width=\"50%\" style=\"padding:14px 20px;border-right:1px solid #F3F4F6;\">\n                <div style=\"font-size:11px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;color:#9CA3AF;\">Teléfono</div>\n                <div style=\"font-size:15px;font-weight:700;color:#111827;margin-top:3px;\">{{ $('Create a row1').item.json.telefono }}</div>\n              </td>\n              <td width=\"50%\" style=\"padding:14px 20px;\">\n                <div style=\"font-size:11px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;color:#9CA3AF;\">Marcas</div>\n                <div style=\"font-size:15px;font-weight:700;color:#006A61;margin-top:3px;\">{{ $('Create a row1').item.json.marcas }}</div>\n              </td>\n            </tr>\n          </table>\n\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F9FAFB;border:1px solid #E5E7EB;border-radius:12px;margin:0 0 24px;\">\n            <tr><td style=\"padding:16px 20px;\">\n              <div style=\"font-size:11px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;color:#9CA3AF;margin-bottom:8px;\">Próximos pasos</div>\n              <div style=\"font-size:14px;line-height:1.7;color:#4B5563;\">1. Contactar al vendedor por WhatsApp o teléfono.<br>2. Verificar sus datos y marcas.<br>3. Activar su cuenta en el panel.</div>\n            </td></tr>\n          </table>\n        </td></tr>\n\n        <tr><td style=\"padding:0 32px 36px;\">\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n            <td style=\"border-radius:12px;background:#00E5E5;\">\n              <a href=\"https://wa.me/{{ $('Create a row1').item.json.telefono }}\" style=\"display:inline-block;padding:15px 30px;font-size:14px;font-weight:700;color:#000000;text-decoration:none;border-radius:12px;\">Escribir al vendedor</a>\n            </td>\n          </tr></table>\n        </td></tr>\n\n        <tr><td style=\"padding:28px 32px;background:#000000;\">\n          <p style=\"margin:0 0 6px;font-size:13px;font-weight:700;color:#FFFFFF;letter-spacing:-0.01em;\">ELECTRIFICARTE<span style=\"color:#00E5E5;\">.COM</span></p>\n          <p style=\"margin:0;font-size:12px;line-height:1.6;color:rgba(255,255,255,0.55);\">Alerta interna generada automáticamente.</p>\n        </td></tr>\n\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n"
            }
