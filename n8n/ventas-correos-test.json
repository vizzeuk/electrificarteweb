ze:13px;line-height:1.4;color:#495251;vertical-align:top;width:34%;\">Teléfono</td>\n    <td style=\"padding:12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;font-weight:600;color:#0f1716;vertical-align:top;\">{{ String(($('Datos correo oferta').item.json.telefono) ?? '').trim().replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px 12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.4;color:#495251;vertical-align:top;width:34%;\">Email</td>\n    <td style=\"padding:12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;font-weight:600;color:#0f1716;vertical-align:top;\">{{ String(($('Datos correo oferta').item.json.email) ?? '').trim().replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 16px 12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.4;color:#495251;vertical-align:top;width:34%;\">Ubicación</td>\n    <td style=\"padding:12px 0;border-bottom:1px solid #dfe4e4;font-family:'Switzer','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;font-weight:600;color:#0f1716;vertical-align:top;\">{{ [$('Datos correo oferta').item.json.comuna, $('Datos correo oferta').item.json.region].filter(Boolean).join(', ').replace(/[&<>\"']/g, c => '&#' + c.charCodeAt(0) + ';') || 'Sin indicar' }}</td>\n  </tr>\n</table>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:8px 0 0;\"><tr>\n  <td style=\"border-radius:8px;background:#1d605b;\">\n    <a href=\"https://wa.me/{{ String(($('Datos correo oferta').item.json.telefono) ?? '').replace(/[^0-9]/g, '') }}\" style=\"display:inline-